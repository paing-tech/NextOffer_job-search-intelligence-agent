# Copy to .env.local

# Shared HS256 secret with the backend (generate: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-string

# FastAPI backend base URL (server-side only; never exposed to the browser)
BACKEND_URL=http://localhost:8000

# "Sign in with Google" (identity only — not the Gmail/Sheets connection, which
# is a separate flow entirely in the backend). Same OAuth Client as the backend's
# GOOGLE_CLIENT_ID/SECRET, with an extra authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
