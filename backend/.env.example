# Copy to .env

# Azure Database for PostgreSQL (async driver). Azure requires TLS.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/nextoffer?ssl=require

# Must match the frontend's AUTH_SECRET exactly.
AUTH_SECRET=replace-with-a-long-random-string

FRONTEND_URL=http://localhost:3000

# Microsoft Foundry (Azure AI Foundry) — GPT-5.6 Terra deployment.
# Azure-OpenAI style: set FOUNDRY_API_VERSION and use the resource endpoint.
# Unified/OpenAI style: leave FOUNDRY_API_VERSION blank and put the full base URL in FOUNDRY_ENDPOINT.
FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
FOUNDRY_API_KEY=
FOUNDRY_API_VERSION=2024-10-21
FOUNDRY_DEPLOYMENT=gpt-5.6-terra

# Fernet key for encrypting stored Google refresh tokens (milestone 1).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Google OAuth (milestone 1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/google/callback
